{
  "name": "karol-sliwa-angular-redesign",
  "version": "1.0.0",
  "description": "Dark cinematic Angular redesign concept for karolsliwa.com powered by WordPress REST API.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open --port 4201",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "ng build",
    "postbuild": "node -e \"const fs=require('fs'); const dir='dist/karol-sliwa-angular-redesign/browser'; for (const file of ['404.html','200.html']) fs.copyFileSync(dir + '/index.html', dir + '/' + file);\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "typescript": "~6.0.0",
    "@angular/build": "^22.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
